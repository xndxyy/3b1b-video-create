# Runtime configuration. Copy this file to .env before generating media.
# Relative paths are resolved from the directory where the command is run.

# cuda, cuda:0, or cpu
DEVICE=cuda

# Leave empty when VoxCPM2 is installed in the active Python environment.
# Set only when importing VoxCPM2 from a local source checkout.
VOXCPM_PATH=

# Local inputs. These files are ignored by Git.
REFERENCE_AUDIO=assets/voices/narrator.wav
TEXTBOOK_PDF=sources/deep-learning-from-scratch.pdf

# Use command names when ffmpeg and ffprobe are available on PATH.
FFMPEG=ffmpeg
FFPROBE=ffprobe
