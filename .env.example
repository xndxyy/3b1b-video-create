# Copy this file to `.env` and fill in YOUR local values.
# Nothing here is committed (see .gitignore).

# Root of THIS repository (where you cloned it)
PROJECT_ROOT=/path/to/deep-learning-3b1b-video

# Path to the VoxCPM2 package install (the folder containing voxcpm/)
VOXCPM_PATH=/path/to/VoxCPM

# Reference voice .wav for cloning (YOUR voice, never committed)
REFERENCE_VOICE_WAV=/path/to/your_voice_reference.wav

# CUDA device for VoxCPM2 / Whisper
DEVICE=cuda

# Path to the textbook PDF on your machine (not committed)
TEXTBOOK_PDF=/path/to/deep-learning-from-scratch.pdf

# ffmpeg / ffprobe executable (usually just "ffmpeg" if on PATH)
FFMPEG=ffmpeg
FFPROBE=ffprobe
